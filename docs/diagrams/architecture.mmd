flowchart TB
    Client(["Client application"])

    SEC["<b>Security filter chain</b><br/><small>JWTAuthFilter · authorization rules</small>"]
    WEB["<b>Controller layer</b><br/><small>Auth · Guest · Admin · Webhook</small>"]
    SVC["<b>Service layer</b><br/><small>Booking · Inventory · Pricing · Checkout</small>"]
    REPO["<b>Repository layer</b><br/><small>Spring Data JPA · custom JPQL · row locks</small>"]
    DB[("PostgreSQL")]

    ADV["<b>Cross-cutting advice</b><br/><small>GlobalExceptionHandler<br/>GlobalResponseHandler</small>"]
    SCH["<b>PricingUpdateService</b><br/><small>@Scheduled, hourly</small>"]
    STRIPE(["Stripe API"])

    Client --> SEC
    SEC --> WEB
    WEB --> SVC
    SVC --> REPO
    REPO --> DB

    ADV -.->|"wraps every response"| WEB
    SCH -->|"recomputes prices"| SVC
    SVC <-->|"checkout · refunds"| STRIPE
    STRIPE -.->|"signed webhook"| WEB

